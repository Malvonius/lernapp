{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"],
    "noEmit": true
  },
  "include": ["src", "tests", "scripts", "e2e", "playwright.config.ts", "vite.config.ts", "vitest.config.ts", "pwa-assets.config.ts"]
}
